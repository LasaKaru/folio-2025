VITE_SERVER_URL=
# server/store.js base URL, for real-money cosmetic purchases (optional --
# premium items just stay unpurchasable without it). Server-side Stripe
# config (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, etc.) is documented in
# server/STORE.md, not here -- those are never read by the client bundle.
VITE_STORE_URL=
VITE_ANALYTICS_TAG=
VITE_GAME_PUBLIC=
VITE_COMPRESSED=
# Model geometry (Draco) compression, ~4x smaller downloads. Safe independently
# of VITE_COMPRESSED (textures) -- set to "false" to force uncompressed models.
VITE_COMPRESSED_MODELS=
VITE_DAY_CYCLE_PROGRESS=
VITE_YEAR_CYCLE_PROGRESS=
VITE_WHISPERS_COUNT=30
VITE_MUSIC=1
VITE_LOG=1
VITE_PLAYER_SPAWN=
