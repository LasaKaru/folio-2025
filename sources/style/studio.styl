.studio-splash
    display flex
    flex-direction column
    align-items center
    justify-content center
    gap 18px
    position fixed
    z-index 9999
    top 0
    left 0
    width 100%
    height 100%
    background #f7f7f2
    opacity 1
    transition opacity 0.6s ease
    pointer-events none

    &.is-hidden
        opacity 0

    .logo
        width min(340px, 60vw)
        height auto

    .tagline
        font-family "Amatic SC", sans-serif
        font-weight 700
        font-size 1.6rem
        letter-spacing 4px
        text-transform uppercase
        color #16213e
        opacity 0.7

.preview.is-generated
    background radial-gradient(ellipse at center, #16213e, #0b0b0c)

.credits-logo
    display flex
    justify-content center
    margin-bottom 20px

    img
        width min(280px, 70%)
        height auto
        filter drop-shadow(0 0 20px alpha(#00e5ff, 0.35))

.multiplayer-status
    display flex
    align-items center
    gap 10px
    margin 12px 0
    padding 10px 14px
    border-radius 8px
    background alpha(#ffffff, 0.06)
    font-weight 700

    .dot
        width 10px
        height 10px
        border-radius 50%
        background #ff4a6b
        box-shadow 0 0 8px #ff4a6b

        html.is-server-online &
            background #54ff9f
            box-shadow 0 0 8px #54ff9f

.multiplayer-players
    display flex
    flex-direction column
    gap 6px
    margin-bottom 10px

    .player-row
        display flex
        align-items center
        gap 10px
        padding 6px 10px
        border-radius 6px
        background alpha(#ffffff, 0.04)
        font-size 0.85rem

        .swatch
            width 12px
            height 12px
            border-radius 50%
            flex-shrink 0
