.studio-splash
    display flex
    flex-direction column
    align-items center
    justify-content center
    gap 18px
    position fixed
    z-index 9999
    top 0
    left 0
    width 100%
    height 100%
    background #f7f7f2
    opacity 1
    transition opacity 0.6s ease
    pointer-events none

    &.is-hidden
        opacity 0

    .wordmark
        font-family "Nunito", sans-serif
        font-weight 900
        font-size min(4.4rem, 13vw)
        letter-spacing 1px
        color #16213e
        line-height 1

        .o2
            background linear-gradient(120deg, #ff2ea0, #00e5ff)
            -webkit-background-clip text
            background-clip text
            color transparent

    .subtitle
        font-family "Nunito", sans-serif
        font-weight 700
        font-size min(1rem, 3.2vw)
        letter-spacing 8px
        color #16213e
        opacity 0.55
        margin-top -8px

    .tagline
        font-family "Amatic SC", sans-serif
        font-weight 700
        font-size 1.6rem
        letter-spacing 4px
        text-transform uppercase
        color #16213e
        opacity 0.7

.preview.is-generated
    background radial-gradient(ellipse at center, #16213e, #0b0b0c)

.credits-logo
    display flex
    justify-content center
    margin-bottom 20px

    img
        width min(280px, 70%)
        height auto
        filter drop-shadow(0 0 20px alpha(#00e5ff, 0.35))

.multiplayer-status
    display flex
    align-items center
    gap 10px
    margin 12px 0
    padding 10px 14px
    border-radius 8px
    background alpha(#ffffff, 0.06)
    font-weight 700

    .dot
        width 10px
        height 10px
        border-radius 50%
        background #ff4a6b
        box-shadow 0 0 8px #ff4a6b

        html.is-server-online &
            background #54ff9f
            box-shadow 0 0 8px #54ff9f

.multiplayer-players
    display flex
    flex-direction column
    gap 6px
    margin-bottom 10px

    .player-row
        display flex
        align-items center
        gap 10px
        padding 6px 10px
        border-radius 6px
        background alpha(#ffffff, 0.04)
        font-size 0.85rem

        .swatch
            width 12px
            height 12px
            border-radius 50%
            flex-shrink 0

.text-input
    padding 8px 10px
    border-radius 6px
    border 1px solid alpha(#ffffff, 0.2)
    background alpha(#000000, 0.25)
    color #ffffff
    font-family inherit
    font-size 0.85rem

    &:focus
        outline none
        border-color #00e5ff

.multiplayer-room
    display flex
    align-items center
    gap 8px
    flex-wrap wrap
    margin-bottom 14px

    .label
        font-size 0.85rem
        opacity 0.8

    .js-multiplayer-room-input
        width 120px

.multiplayer-chat-log
    display flex
    flex-direction column
    gap 4px
    max-height 160px
    overflow-y auto
    margin 10px 0
    padding 8px 10px
    border-radius 6px
    background alpha(#000000, 0.25)
    font-size 0.8rem

    .chat-line
        line-height 1.4

    .chat-author
        font-weight 700
        color #00e5ff

.multiplayer-chat-input-row
    display flex
    gap 8px
    margin-bottom 14px

    .js-multiplayer-chat-input
        flex 1

.social-links
    display flex
    flex-wrap wrap
    gap 10px
    margin 14px 0 20px

    .social-link
        display inline-flex
        align-items center
        gap 6px
        padding 8px 14px
        border-radius 20px
        background alpha(#ffffff, 0.06)
        border 1px solid alpha(#00e5ff, 0.3)
        font-weight 700
        font-size 0.85rem
        text-decoration none
        color #ffffff
        transition background 0.2s ease, transform 0.2s ease, border-color 0.2s ease
        cursor pointer

        html:not(.is-mode-touch) &:hover
            background alpha(#00e5ff, 0.16)
            border-color #00e5ff
            transform translateY(-2px)

    .social-link--donate
        background linear-gradient(135deg, alpha(#ff2ea0, 0.25), alpha(#ffd23f, 0.2))
        border-color #ffd23f

        html:not(.is-mode-touch) &:hover
            background linear-gradient(135deg, alpha(#ff2ea0, 0.4), alpha(#ffd23f, 0.35))
            border-color #ffd23f

    .social-link--soon
        opacity 0.45
        border-color alpha(#ffffff, 0.2)
        cursor default

        html:not(.is-mode-touch) &:hover
            background alpha(#ffffff, 0.06)
            border-color alpha(#ffffff, 0.2)
            transform none

.leaderboard-list
    list-style position inside
    margin 0 0 20px
    padding 10px 14px
    border-radius 8px
    background alpha(#ffffff, 0.06)

    li
        padding 3px 0
        font-weight 700
