.garage-trigger
    display none
    position absolute
    right 0
    top 122px
    width 44px
    height 44px
    z-index 9
    -webkit-user-select none
    -moz-user-select none
    user-select none

    html.is-started &
        display block

    html.input-filter-menu &
    html.input-filter-cinematic &
    html.input-filter-intro &
        pointer-events none

    --hover-translate 4px

    html:not(.is-mode-touch) &:hover
        .button-inner
            transform translateX(-4px)

    .button-inner
        display flex
        align-items center
        justify-content center
        position absolute
        top 0
        left 0
        width calc(100% + var(--hover-translate))
        height 100%
        font-size 20px
        background radial-gradient(ellipse at top right, #ff2ea0, #46123B)
        transition transform 0.15s 0.15s

        html.input-filter-menu &,
        html.input-filter-modal &,
        html.input-filter-intro &
        html.input-filter-cinematic &
            transform translateX(100%)
            transition-delay 0

.modal.garage
    .container
        width 620px
        max-width calc(100vw - 40px)

    .content
        max-height 80vh
        overflow-y auto

.garage-cash
    margin-bottom 15px
    padding 10px 14px
    border-radius 8px
    background alpha(#ffd23f, 0.12)
    border 1px solid alpha(#ffd23f, 0.4)
    color #ffd23f
    font-weight 900
    text-align center

.garage-section
    margin-bottom 20px

    .garage-section-title
        margin-bottom 6px
        font-family "Amatic SC", sans-serif
        font-weight 700
        font-size 1.6rem
        color #00e5ff

.garage-row
    display flex
    align-items center
    gap 10px
    padding 8px 0
    border-bottom 1px solid alpha(#ffffff, 0.08)

    &:last-child
        border-bottom none

    .info
        flex 1
        min-width 0

        .title
            font-weight 700
            font-size 0.9rem

        .description
            font-size 0.7rem
            opacity 0.65

    .value
        min-width 70px
        font-size 0.75rem
        text-align right
        opacity 0.8
        white-space nowrap

    button
        flex-shrink 0
        height 36px
        padding 0 12px
        font-size 0.75rem

.survival-panel
    margin-top 10px
    padding 12px 16px
    min-width 200px
    border-radius 8px
    border 1px solid alpha(#ffd23f, 0.4)
    background linear-gradient(135deg, alpha(#251f2b, 0.85), alpha(#1d1721, 0.85))
    transition opacity 0.3s

    &.is-hidden
        opacity 0

    .name
        font-family "Amatic SC", sans-serif
        font-weight 700
        font-size 1.6rem
        color #ffd23f

    .stats
        display flex
        justify-content space-between
        font-weight 700
        font-size 0.85rem

.weapon-name
    color #00e5ff
    font-weight 700
