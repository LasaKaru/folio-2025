.havoc-hud
    position absolute
    top 20px
    left 20px
    z-index 2
    color #ffffff
    pointer-events none
    user-select none
    transition opacity 0.4s
    text-shadow 0 2px 8px alpha(#000000, 0.5)

    &.is-hidden
        opacity 0

    .top-row
        display flex
        align-items baseline
        gap 14px

    .brand
        font-family "Amatic SC", sans-serif
        font-weight 700
        font-size 2rem
        letter-spacing 2px
        line-height 1
        background linear-gradient(90deg, #00e5ff, #ff2ea0)
        -webkit-background-clip text
        background-clip text
        -webkit-text-fill-color transparent

    .cash
        font-weight 900
        font-size 1.1rem
        color #ffd23f

    .health
        margin-top 8px
        width 190px
        height 8px
        border-radius 4px
        background alpha(#ffffff, 0.15)
        overflow hidden

        .fill
            width 100%
            height 100%
            border-radius 4px
            background linear-gradient(90deg, #54ff9f, #00e5ff)
            transform-origin 0 50%
            transition transform 0.2s

            &.is-low
                background linear-gradient(90deg, #ff4a6b, #ff2ea0)

    .vehicle-health
        margin-top 4px
        width 190px
        height 5px
        border-radius 3px
        background alpha(#ffffff, 0.12)
        overflow hidden

        .fill
            width 100%
            height 100%
            border-radius 3px
            background linear-gradient(90deg, #00e5ff, #b56bff)
            transform-origin 0 50%
            transition transform 0.2s

            &.is-low
                background linear-gradient(90deg, #ff4a6b, #ff8c3a)

    .story-line
        margin-top 6px
        font-size 0.7rem
        font-weight 700
        letter-spacing 0.5px
        color #b56bff
        text-transform uppercase

    .foot-hint
        margin-top 8px
        font-size 0.65rem
        opacity 0.7
        transition opacity 0.3s

        &.is-hidden
            opacity 0

    .daily-challenge
        margin-top 6px
        font-size 0.65rem
        font-weight 700
        color #ffd23f
        opacity 0.85

    .mission-panel
        margin-top 10px
        padding 12px 16px
        min-width 220px
        max-width 300px
        border-radius 8px
        border 1px solid alpha(#00e5ff, 0.4)
        background linear-gradient(135deg, alpha(#251f2b, 0.85), alpha(#1d1721, 0.85))
        transition opacity 0.3s

        &.is-hidden
            opacity 0

        .name
            font-family "Amatic SC", sans-serif
            font-weight 700
            font-size 1.6rem
            line-height 1.1
            color #00e5ff

        .objective
            margin-top 2px
            font-size 0.75rem
            opacity 0.8

        .stats
            display flex
            justify-content space-between
            align-items baseline
            margin-top 8px

            .timer
                font-weight 900
                font-size 1.3rem
                font-variant-numeric tabular-nums

                &.is-danger
                    color #ff4a6b
                    animation havoc-timer-blink 0.5s infinite alternate

            .progress
                font-weight 700
                font-size 1rem
                color #ff2ea0

.damage-flash
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    pointer-events none
    z-index 3
    opacity 0
    background radial-gradient(ellipse at center, transparent 55%, alpha(#ff1d3d, 0.55) 100%)

    &.is-active
        animation havoc-damage-flash 0.45s ease-out

@keyframes havoc-damage-flash
    0%
        opacity 1
    100%
        opacity 0

.notifications
    .notification
        &.is-mission
            .top
                display flex
                justify-content space-between
                align-items center
                margin-bottom 5px

                .title
                    text-align left
                    color #00e5ff
                    font-size 1.7rem
                    margin-right 10px
                    line-height 1em
                    margin-bottom 0.25em

            .bottom
                display flex
                justify-content space-between
                align-items flex-start

                .description
                    margin-right 10px
                    margin-bottom 0
                    color #ffffff
                    line-height 1em
                    font-size 16px

            .time-bar
                background #00e5ff

@keyframes havoc-timer-blink
    from
        opacity 1
    to
        opacity 0.45

@media only screen and (max-width 520px)
    .havoc-hud
        top 12px
        left 12px

        .brand
            font-size 1.5rem

        .mission-panel
            min-width 170px
            padding 8px 12px
