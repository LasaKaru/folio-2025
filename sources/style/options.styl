.keybind-capture
    position fixed
    top -100px
    left -100px
    width 1px
    height 1px
    opacity 0
    pointer-events none

.menu .contents .options-content

    .content-inner
        display flex
        flex-direction column
        justify-content flex-start
        align-items center

    table
        border-spacing 0 10px

        td:first-child
            padding-right 40px
        
    .audio-toggle
        img
            width 29px
            height 27px

            &.audio-off
                display none
                
            &.audio-on
                display block

        html.is-audio-muted &
            img
                &.audio-on
                    display none

                &.audio-off
                    display block

    .keybinds-title
        margin 4px 0 10px
        font-family "Amatic SC", sans-serif
        font-weight 700
        font-size 1.4rem
        color #00e5ff

    .keybind-row
        width 100%

        .keybind-key
            min-width 90px

            &.is-listening
                color #ffd23f
                border-color #ffd23f

    .button
        display flex
        align-items center
        justify-content center
        width 100%